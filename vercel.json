{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/",       "destination": "/animal",                 "permanent": true },
    { "source": "/animal", "destination": "/index.html?site=animal", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
